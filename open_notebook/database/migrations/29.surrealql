-- Migration 29: Create notebook_access table for super-admin managed grants

DEFINE TABLE IF NOT EXISTS notebook_access SCHEMAFULL;

DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE notebook_access TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS user_email ON TABLE notebook_access TYPE string;
DEFINE FIELD IF NOT EXISTS granted_by ON TABLE notebook_access TYPE string;
DEFINE FIELD IF NOT EXISTS granted_at ON TABLE notebook_access TYPE datetime DEFAULT time::now();

DEFINE INDEX IF NOT EXISTS idx_notebook_access_lookup
ON TABLE notebook_access
FIELDS notebook_id, user_email UNIQUE;

DEFINE INDEX IF NOT EXISTS idx_notebook_access_user_email
ON TABLE notebook_access
FIELDS user_email;
